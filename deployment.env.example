# Fleet requires these FOUR settings. Blank values fail startup.
# Copy this file to deployment.env at the repository root; never commit that copy.
# Generate your own admin secret, for example: openssl rand -hex 32
FLEET_ADMIN_TOKEN=
# Optional, only while rotating the admin token without downtime (see
# packages/fleet-controller/docs/access-and-config-safety.md). Leave unset otherwise.
# FLEET_ADMIN_TOKEN_NEXT=
# Existing S3-compatible bucket NAME, not an s3:// URL
FLEET_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: set for non-AWS S3-compatible storage; HTTPS origin, no path or query.
# FLEET_S3_ENDPOINT=https://objects.example.org
# AWS_REGION=us-east-1
# FLEET_S3_PREFIX=fleet
# AWS_SESSION_TOKEN=

# Optional: an absolute local SQLite working-file path.
# Default: packages/fleet-controller/data/fleet.db under this checkout.
# FLEET_DATABASE_PATH=/var/lib/fleet/fleet.db
# PORT=8080
# FLEET_LITESTREAM_BIN=/usr/local/bin/litestream
# FLEET_STARTUP_TIMEOUT_SECONDS=60

# Optional browser login: supply ALL THREE or leave all three unset.
# One operator-owned OIDC user pool, directly connected; no shared auth relay.
# Register a public code + S256 PKCE client with verified email claims.
# Register FLEET_PUBLIC_ORIGIN/auth/callback with your OIDC provider.
# FLEET_OIDC_ISSUER=https://your-identity-provider
# FLEET_OIDC_CLIENT_ID=your-client-id
# FLEET_PUBLIC_ORIGIN=https://fleet.example.org

# Optional auto-approval: JSON array (at most 16) of enrollment-token SHA-256 hashes,
# each with the role to assign when the node has none (an active role, or null).
# Default: []. FLEET_ROLE_TOKEN_HASHES is no longer supported and refuses startup.
# FLEET_ENROLLMENT_TOKENS=[{"sha256":"<64 hex>","role":"ci"},{"sha256":"<64 hex>","role":null}]

# Optional application-owned public installer artifacts (built files and SHA-256 sidecars).
# FLEET_INSTALLER_DIR=/var/lib/fleet/installers
# Optional desired Git revision for drift display; no GitHub API lookup.
# FLEET_TARGET_REVISION=
# Optional heartbeat history retention in whole days (1-365, default 30). Events,
# settings history and the audit log are not pruned by it.
# FLEET_HEARTBEAT_RETENTION_DAYS=30

# Optional GitHub Actions runner integration: the controller holds the GitHub App
# key so no node does. Set ONE of the two key variables; configure the App ID,
# installation ID and repositories on the dashboard's Runners page afterwards.
# Never commit the key. See packages/fleet-controller/docs/github-runners.md.
# FLEET_GITHUB_APP_PRIVATE_KEY_FILE=/etc/fleet/github-app.pem
# FLEET_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Optional: enables POST /v1/github/webhook (HMAC-SHA256, at least 16 characters).
# FLEET_GITHUB_WEBHOOK_SECRET=
# Optional: GitHub Enterprise Server API origin. Default https://api.github.com.
# FLEET_GITHUB_API_URL=

# Optional one-click issue reporting. The repository alone enables the prefilled
# "new issue" link; the token (fine-grained, "Issues: write" on that repository
# only) enables "Create GitHub issue". Never commit the token.
# See packages/fleet-controller/docs/issue-reporting.md.
# FLEET_ISSUES_REPOSITORY=owner/name
# FLEET_ISSUES_GITHUB_TOKEN=
# Optional: comma-separated labels (default fleet-report).
# FLEET_ISSUES_LABELS=fleet-report
# Optional: GitHub Enterprise Server API origin. Default https://api.github.com.
# FLEET_ISSUES_GITHUB_API_URL=
# Optional: the Git commit this controller was built from, shown in reports.
# FLEET_CONTROLLER_COMMIT=

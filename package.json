{
  "name": "fleet",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run tc && bun run lint && bun run build && bun run test",
    "tc": "bun run --filter \"@pkgs/*\" tc",
    "lint": "bun run --filter \"@pkgs/*\" lint",
    "test": "bun test ./scripts && bun run test:support && bun run --cwd packages/fleet test && bun run --cwd packages/fleet-api test:unit",
    "build": "bun run --cwd packages/fleet-api build",
    "dev": "bun run --cwd packages/fleet-api dev",
    "dev:fixtures": "bun run --cwd packages/fleet-api dev:fixtures",
    "check:nix": "bun run --cwd packages/fleet check:nix",
    "roles:sync": "python3 packages/fleet/scripts/fleet_roles.py sync",
    "format": "prettier --write .",
    "test:support": "bun run --cwd packages/assert test && bun run --cwd packages/logger test && bun run --cwd packages/admin-ui test"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-lingui": "catalog:",
    "eslint-plugin-naming": "catalog:",
    "eslint-plugin-no-only-tests": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "catalog": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@inquirer/prompts": "^8.5.2",
    "@types/bun": "^1.3.9",
    "@types/node": "^22.15.29",
    "chalk": "^6.0.0",
    "commander": "^14.0.2",
    "ora": "^8.2.0",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "aws4fetch": "^1.0.20",
    "bun-types": "^1.3.9",
    "eslint": "^9.25.0",
    "eslint-plugin-lingui": "^0.13.1",
    "eslint-plugin-naming": "^0.1.10",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hono": "^4.7.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.4",
    "turbo": "^2.9.16",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.1",
    "yaml": "^2.9.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2"
  }
}

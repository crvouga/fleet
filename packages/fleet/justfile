set shell := ["bash", "-euo", "pipefail", "-c"]

# Run from this package: just --justfile packages/fleet/justfile ...
build-iso:
    nix build -L path:.#installer -o result-iso

build-node:
    nix build -L path:.#ci -o result-node

# Any closure in roles.json: just build devbox, just build ci-gpu.
build closure:
    nix build -L path:.#{{closure}} -o result-{{closure}}

# Role lists outside roles.json are copies. Rewrite them after editing it.
roles-sync:
    python3 scripts/fleet_roles.py sync

flash-usb iso device:
    bash scripts/flash-usb.sh {{quote(iso)}} {{quote(device)}}

fetch-iso:
    bash scripts/fetch-iso.sh fleet-installer.iso

# Forward a keyboard to fleet-install on a machine already in the live image.
# The installer takes no role; assign it in the Fleet app after approval.
bootstrap ip:
    bash scripts/bootstrap.sh {{quote(ip)}}

# Print .sops.yaml creation rules from the controller's GET /v1/recipients JSON
# (a file, or - for stdin) plus your operator recipients. No network, no secrets.
# Example: just fleet-keys --operator age1... recipients.json > .sops.yaml
fleet-keys *args:
    python3 scripts/fleet-keys.py {{args}}

# The one-time setup the repository owner does, once for the whole fleet: the
# runner GitHub App, the encrypted CI secrets, fleet.nix. Render .sops.yaml with
# fleet-keys first. A new node never repeats any of it. Example: just setup --repos owner/private-app
setup *args:
    python3 scripts/setup.py {{args}}

status node:
    bash scripts/node.sh status {{quote(node)}}

check-local:
    bash scripts/check.sh

check:
    bash scripts/check.sh
    nix flake check path:. --system x86_64-linux -L

vm-test:
    nix build -L path:.#checks.x86_64-linux.vm
    nix build -L path:.#checks.x86_64-linux.devbox-vm
    nix build -L path:.#checks.x86_64-linux.native-vm
    nix build -L path:.#checks.x86_64-linux.lifecycle
    nix build -L path:.#checks.x86_64-linux.follow-up
    nix build -L path:.#checks.x86_64-linux.runner-registration-vm
    nix build -L path:.#checks.x86_64-linux.cattle
    nix build -L path:.#checks.x86_64-linux.cattle-vm
